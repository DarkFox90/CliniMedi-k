{
	"name": "clinimedik-correos",
	"main": "src/index.js",
	"compatibility_date": "2026-11-10",
	// Hora UTC. 14:00 UTC = 08:00 en Guatemala (recordatorios); 00:00 UTC = 18:00 en Guatemala (aviso a la clínica).
	"triggers": {
		"crons": ["0 14 * * *", "0 0 * * *"]
	},
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "CITAS",
			"id": "19ecd2f3adc14674bac2fdc6ea123df7"
		}
	]
}